<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-US">
  <info>
    <title>Custom Author-Year Journal Style (Surname, Initials, Year, Title, Journal, Vol(Issue), pp, DOI)</title>
    <id>http://www.zotero.org/styles/custom-journal-style</id>
    <link href="http://www.zotero.org/styles/custom-journal-style" rel="self"/>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Custom style: Surname, I. (Year) Title, Journal (italic), Vol (bold), (Issue), pages, DOI</summary>
    <updated>2026-09-11T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" and="text" sort-separator=", " initialize-with=". " delimiter=", " delimiter-precedes-last="always"/>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued-year">
    <date variable="issued" prefix="(" suffix=")">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <text variable="title"/>
  </macro>

  <macro name="container">
    <text variable="container-title" font-style="italic"/>
  </macro>

  <macro name="volume-issue-pages">
    <group delimiter=", ">
      <text variable="volume" font-weight="bold"/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="doi">
    <text variable="DOI" prefix="https://doi.org/"/>
  </macro>

  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <names variable="author">
          <name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
          <et-al/>
        </names>
        <date variable="issued">
          <date-part name="year"/>
        </date>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="1" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <group delimiter=" ">
        <text macro="author" suffix=""/>
        <text macro="issued-year"/>
      </group>
      <text macro="title" prefix=" " suffix=","/>
      <text macro="container" prefix=" " suffix=","/>
      <text macro="volume-issue-pages" prefix=" " suffix="."/>
      <text macro="doi" prefix=" "/>
    </layout>
  </bibliography>

</style>
